{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "C:/Users/hmod/.config/fastfetch/hm.txt",
    "color": {
      "1": "#050507",
      "2": "#ADD8E6",
      "3": "#ADD8E6",
      "4": "#160D1D",
      "5": "#ADD8E6",
      "6": "#30163D",
      "7": "#431D55",
      "8": "#633078",
      "9": "#8B4FA3"
    },
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "#8B4FA3",
        "at": "#431D55",
        "host": "#633078"
      }
    },
    "break",
    {
      "type": "os",
      "key": "",
      "keyColor": "#633078"
    },
    {
      "type": "cpu",
      "key": "",
      "keyColor": "#8B4FA3"
    },
    {
      "type": "board",
      "key": "󰚗",
      "keyColor": "#431D55"
    },
    {
      "type": "memory",
      "key": "",
      "keyColor": "#633078",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "disk",
      "key": "",
      "keyColor": "#30163D"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
